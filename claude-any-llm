#!/bin/sh
# Launch Claude Code against the development gateway's opt-in compatibility catalog.

name=$(basename "$0")
base_url="${ANTHROPIC_BASE_URL:-https://dev.api.llm-gateway.iocloudhost.net}"
default_model=qwen3.8-flash-long-context
requested_model="${ANTHROPIC_MODEL:-}"
requested_from_state=false
key_secret=LLM_GATEWAY_DEV_API_KEY
key_helper="doppler secrets get $key_secret -p personal -c dev --plain"
say() { printf '%s: %s\n' "$name" "$*" >&2; }
die() { exit_status=$1; shift; say "$@"; exit "$exit_status"; }

# Claude Code persists /model and /effort picks into its config dir's settings.json,
# so a launcher session runs in its own config dir: those picks stay launcher-private
# and plain `claude` never inherits a catalog id. Everything a resumed or remembered
# session needs (transcripts, prompt history, trust and MCP state in .claude.json,
# checkpoints, plans, pastes) links back to the shared dir, so /resume and history stay
# one store with plain `claude`. Claude Code writes history.jsonl and .claude.json in
# place, so the links survive a session.
launcher_config_dir="$HOME/.config/claude-llm/$name"
launcher_settings="$launcher_config_dir/settings.json"
# Links $2 to $1. An existing correct link (a concurrent first launch made it) is
# success; anything else already at $2 is left untouched and named once.
link_shared_entry() {
  [ "$(readlink "$2" 2>/dev/null)" = "$1" ] && return 0
  if [ -e "$2" ] || [ -L "$2" ]; then say "$2 is not a link to $1"; return 73; fi
  ln -sn "$1" "$2" 2>/dev/null || [ "$(readlink "$2" 2>/dev/null)" = "$1" ] || return 73
}

if [ "${CLAUDE_CONFIG_DIR:-}" != "$launcher_config_dir" ]; then
  shared_config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    shared_global_config="$CLAUDE_CONFIG_DIR/.claude.json"
  else
    shared_global_config="$HOME/.claude.json"
  fi
  mkdir -p "$launcher_config_dir" "$shared_config_dir" || exit 73
  # Absent shared targets are created first (files no-clobber, never truncated), so a
  # first launcher run cannot fork state that plain `claude` would later create.
  for shared_entry in projects history.jsonl CLAUDE.md rules skills agents commands \
    hooks output-styles memories plugins file-history plans paste-cache; do
    shared_path="$shared_config_dir/$shared_entry"
    [ -L "$shared_path" ] && [ ! -e "$shared_path" ] && die 73 "$shared_path is a dangling link"
    if [ ! -e "$shared_path" ]; then
      case "$shared_entry" in
        history.jsonl | CLAUDE.md) (set -C; : > "$shared_path") 2>/dev/null ;;
        *) mkdir -p "$shared_path" 2>/dev/null ;;
      esac
      [ -e "$shared_path" ] ||
        die 73 "could not create $shared_path; $shared_entry is not shared this launch"
    fi
    case "$shared_entry" in
      history.jsonl | CLAUDE.md) [ -f "$shared_path" ] ;;
      *) [ -d "$shared_path" ] ;;
    esac || die 73 "shared state has the wrong type: $shared_path"
    link_shared_entry "$shared_path" "$launcher_config_dir/$shared_entry" || exit 73
  done
  # A missing .claude.json is Claude Code's defaults; it writes the file through the link.
  if [ ! -e "$shared_global_config" ] && [ ! -L "$shared_global_config" ]; then
    (set -C; : > "$shared_global_config") 2>/dev/null ||
      die 73 "could not create $shared_global_config"
  fi
  [ -f "$shared_global_config" ] || die 73 "shared state has the wrong type: $shared_global_config"
  link_shared_entry "$shared_global_config" "$launcher_config_dir/.claude.json" || exit 73

  # settings.json is private, rebuilt every launch as the shared settings minus their
  # model and effort, plus this launcher's own last /model and /effort picks, so shared
  # hooks, permissions, plugins, env, and cleanupPeriodDays changes always apply.
  # Tradeoff: any other setting a launcher session writes is replaced next launch.
  shared_settings="$shared_config_dir/settings.json"
  [ -f "$shared_settings" ] || shared_settings=/dev/null
  prior_settings="$launcher_settings"
  jq -e 'type == "object"' "$prior_settings" >/dev/null 2>&1 || prior_settings=/dev/null
  settings_tmp=$(mktemp "$launcher_settings.XXXXXX") || exit 73
  if jq -n --slurpfile shared "$shared_settings" --slurpfile prior "$prior_settings" '
    ($shared[0] // {}) as $base
    | ($prior[0] // {}) as $own
    | if ($base | type) != "object" or ($own | type) != "object" then error("not an object") else . end
    | ($base | del(.model, .effortLevel))
      + ($own | with_entries(select(.key == "model" or .key == "effortLevel")))
  ' > "$settings_tmp" 2>/dev/null; then
    mv "$settings_tmp" "$launcher_settings" || { rm -f "$settings_tmp"; exit 73; }
  else
    rm -f "$settings_tmp"
    [ "$prior_settings" != /dev/null ] || die 65 "$shared_settings is not a JSON object; fix it to launch"
    say "$shared_settings is not a JSON object; keeping the previous $launcher_settings"
  fi
  export CLAUDE_CONFIG_DIR="$launcher_config_dir"
fi

# Continuity: a /model pick this launcher's sessions saved as their default.
if [ -z "$requested_model" ]; then
  requested_model=$(jq -er '.model | strings | select(length > 0)' "$launcher_settings" 2>/dev/null) || requested_model=
  [ -z "$requested_model" ] || requested_from_state=true
fi
requested_model="${requested_model:-$default_model}"

# Rotate every non-launcher argument behind a unique boundary marker. This lets
# the launcher recognize its model option anywhere before `--` without
# lossy string reconstruction of Claude Code arguments.
model_option_seen=false
model_argument_boundary="__claude_any_llm_boundary_$$"
while :; do
  model_argument_boundary_conflict=false
  for argument in "$@"; do
    if [ "$argument" = "$model_argument_boundary" ]; then
      model_argument_boundary_conflict=true
      break
    fi
  done
  [ "$model_argument_boundary_conflict" = false ] && break
  model_argument_boundary="${model_argument_boundary}_"
done

set -- "$@" "$model_argument_boundary"
while [ "$1" != "$model_argument_boundary" ]; do
  case "$1" in
    -m | --model | -m=* | --model=*)
      [ "$model_option_seen" = false ] || die 64 "-m/--model may be specified only once"
      model_option_seen=true
      requested_from_state=false
      case "$1" in
        *=*) requested_model=${1#*=}; [ -n "$requested_model" ] || die 64 "$1 needs a value" ;;
        *)
          model_option=$1
          shift
          if [ "$1" = "$model_argument_boundary" ] || [ -z "$1" ] || [ "${1#-}" != "$1" ]; then
            die 64 "$model_option needs a value"
          fi
          requested_model=$1
          ;;
      esac
      shift
      ;;
    --)
      argument=$1
      shift
      set -- "$@" "$argument"
      while [ "$1" != "$model_argument_boundary" ]; do
        argument=$1
        shift
        set -- "$@" "$argument"
      done
      ;;
    *)
      argument=$1
      shift
      set -- "$@" "$argument"
      ;;
  esac
done
shift

export ANTHROPIC_BASE_URL="${base_url%/}"
export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
# Catalog ids embed the canonical name verbatim (llmgw-anthropic/<canonical>),
# so an alias like claude-opus-5 now appears inside the wire id. Keep Claude
# Code's legacy first-party model remap away from those embedded names.
export CLAUDE_CODE_DISABLE_LEGACY_MODEL_REMAP=1

# Managed clients wait longer than Claude Code's 10-minute SDK default while
# retaining a finite 30-minute inter-chunk idle guard. API_FORCE_IDLE_TIMEOUT=0
# disables Bun's separate five-minute custom-base-url idle cap. Caller values
# remain authoritative.
: "${API_TIMEOUT_MS:=3000000}"
: "${API_FORCE_IDLE_TIMEOUT:=0}"
: "${CLAUDE_STREAM_IDLE_TIMEOUT_MS:=1800000}"
# Background (async) agents have an outer progress watchdog. Keep it beyond
# the inner 1800s stream recovery plus one 1500s first-progress wait and the
# 300s policy margin (#429; derivation in contracts/cross-plane.json). A
# caller-set value wins.
: "${CLAUDE_ASYNC_AGENT_STALL_TIMEOUT_MS:=3600000}"
export API_TIMEOUT_MS API_FORCE_IDLE_TIMEOUT CLAUDE_STREAM_IDLE_TIMEOUT_MS \
  CLAUDE_ASYNC_AGENT_STALL_TIMEOUT_MS

# Ignore model slots inherited from another Claude launcher. The selected
# compatibility ID seeds every slot; the Sonnet slot, which CC's auto-mode
# permission judge resolves through, is pinned to the cache-honoring
# classifier below once the catalog confirms this gateway serves it.
# /model stays fully live: the whole compatibility catalog is offered.
unset ANTHROPIC_DEFAULT_MODEL ANTHROPIC_DEFAULT_FABLE_MODEL
unset ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL
unset ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_SMALL_FAST_MODEL
# Auto-mode permission judge (SONNET slot): z-ai/glm-5.3-flash (OpenRouter,
# Anthropic-protocol) honors the judge's cache_control:ephemeral system block,
# so repeat judge calls read the ~30k-token prefix from cache ($0.015/M vs
# $0.075/M input). Claude Code vets the Sonnet-slot pin against
# availableModels, so the classifier's canonical id also joins that
# allowlist; a gateway without the alias keeps the judge on the startup
# model.
classifier_model="${CLAUDE_LLM_CLASSIFIER_MODEL:-z-ai/glm-5.3-flash}"

# Credentials are selective: existing Anthropic credentials, an optional
# launcher env file, or exactly one Doppler personal/dev secret, which Claude Code
# reads itself through apiKeyHelper (sent as both x-api-key and Bearer) so the key
# never enters its environment.
env_file="${CLAUDE_LLM_ENV_FILE:-$HOME/.config/claude-llm/$name.env}"
if [ -z "${ANTHROPIC_AUTH_TOKEN:-}" ] && [ -z "${ANTHROPIC_API_KEY:-}" ] &&
  [ -f "$env_file" ]; then
  set -a
  . "$env_file"
  set +a
fi
for reserved_header in authorization x-api-key x-lgw-cache-key x-lgw-claude-code-catalog; do
  printf '%s\n' "${ANTHROPIC_CUSTOM_HEADERS:-}" |
    grep -qi "^[[:space:]]*$reserved_header[[:space:]]*:" &&
    die 64 "ANTHROPIC_CUSTOM_HEADERS already sets $reserved_header"
done
if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
  unset ANTHROPIC_AUTH_TOKEN
  export ANTHROPIC_API_KEY
  auth_header=$(printf 'x-api-key: %s' "$ANTHROPIC_API_KEY" | jq -Rsr '@json')
  key_helper=
elif [ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]; then
  export ANTHROPIC_AUTH_TOKEN
  auth_header=$(printf 'authorization: Bearer %s' "$ANTHROPIC_AUTH_TOKEN" | jq -Rsr '@json')
  key_helper=
else
  # The launcher's own catalog and usage reads take the same key once, in memory.
  gateway_key=$($key_helper 2>/dev/null) && [ -n "$gateway_key" ] ||
    die 64 "no API key found. Export ANTHROPIC_AUTH_TOKEN or ANTHROPIC_API_KEY,
  create $env_file, or provide $key_secret in Doppler personal/dev."
  auth_header=$(printf 'x-api-key: %s' "$gateway_key" | jq -Rsr '@json')
  unset gateway_key ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY
fi

usage_key="claude-any-llm:$(uuidgen | tr '[:upper:]' '[:lower:]')"
if [ -n "${ANTHROPIC_CUSTOM_HEADERS:-}" ]; then
  ANTHROPIC_CUSTOM_HEADERS="$ANTHROPIC_CUSTOM_HEADERS
X-LGW-Cache-Key: $usage_key
X-LGW-Claude-Code-Catalog: 1"
else
  ANTHROPIC_CUSTOM_HEADERS="X-LGW-Cache-Key: $usage_key
X-LGW-Claude-Code-Catalog: 1"
fi
if ! printf '%s\n' "${ANTHROPIC_CUSTOM_HEADERS:-}" |
  grep -qi '^[[:space:]]*x-lgw-first-byte-budget-s[[:space:]]*:'; then
  ANTHROPIC_CUSTOM_HEADERS="$ANTHROPIC_CUSTOM_HEADERS
X-LGW-First-Byte-Budget-S: ${CLAUDE_LLM_FIRST_BYTE_BUDGET_S:-1500}"
fi
# KV-cache repeater identity (X-LGW-Affinity-Key): one prompt family per
# project, so the gateway pins every session of this project to ONE warm
# self-hosted host — a NEW session then reuses that host's warm system-prompt
# prefix instead of scattering to a cold host on its per-session salt (#368).
# Same block as claude-qwen/gemma/muse; a caller-set key is respected untouched.
if ! printf '%s\n' "${ANTHROPIC_CUSTOM_HEADERS:-}" |
  grep -qi '^[[:space:]]*x-lgw-affinity-key[[:space:]]*:'; then
  project_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  affinity_family="cc:$(printf '%s' "$(basename "$project_root")" | tr -c 'A-Za-z0-9._-' '-')"
  ANTHROPIC_CUSTOM_HEADERS="$ANTHROPIC_CUSTOM_HEADERS
X-LGW-Affinity-Key: $affinity_family"
fi
if ! printf '%s\n' "${ANTHROPIC_CUSTOM_HEADERS:-}" |
  grep -qi '^[[:space:]]*x-user-id[[:space:]]*:'; then
  ANTHROPIC_CUSTOM_HEADERS="$ANTHROPIC_CUSTOM_HEADERS
X-User-ID: claude-code:codeAgent"
fi
export ANTHROPIC_CUSTOM_HEADERS

# Credentials travel through curl's stdin config, never its argv. Supplying an
# Anthropic version asks the shared /v1/models route for its Anthropic shape.
catalog=$(
  {
    printf 'header = %s\n' "$auth_header"
    printf '%s\n' 'header = "anthropic-version: 2023-06-01"'
    printf '%s\n' 'header = "X-LGW-Claude-Code-Catalog: 1"'
    printf '%s\n' 'header = "accept: application/json"'
  } | curl --silent --show-error --fail --max-time 10 --config - \
    "$ANTHROPIC_BASE_URL/v1/models?limit=1000"
) || die 69 "gateway compatibility catalog unavailable"

rows=$(printf '%s\n' "$catalog" | jq -ce '
  def valid_id:
    type == "string"
    and length > 0
    and (explode | all(. >= 32 and . != 127));
  if (.data | type) != "array"
    or (all(.data[]; (.id | valid_id) and (.canonical_id | valid_id)) | not)
    or ([.data[].id] | unique | length) != (.data | length)
    or ([.data[].canonical_id] | unique | length) != (.data | length)
  then error("malformed compatibility catalog")
  else .data
  end
' 2>/dev/null) || die 65 "gateway returned a malformed compatibility catalog"

# The one catalog row whose id or canonical id is $1; empty when missing or ambiguous.
catalog_row() {
  printf '%s\n' "$rows" | jq -ce --arg model "$1" \
    '[.[] | select(.id == $model or .canonical_id == $model)] | if length == 1 then .[0] else empty end' 2>/dev/null
}
selected=$(catalog_row "$requested_model")
if [ -z "$selected" ] && [ "$requested_from_state" = true ]; then
  requested_model=$default_model
  requested_from_state=false
  selected=$(catalog_row "$requested_model")
fi
[ -n "$selected" ] || die 65 "model '$requested_model' is not in the gateway compatibility catalog"

selected_id=$(printf '%s\n' "$selected" | jq -r '.id')

catalog_has_model() {
  printf '%s\n' "$rows" | jq -e --arg model "$1" \
    'any(.[]; .id == $model or .canonical_id == $model)' >/dev/null 2>&1
}

# Pin the auto-mode permission judge only on gateways that serve the
# classifier alias.
if ! catalog_has_model "$classifier_model"; then
  say "classifier '$classifier_model' not in this gateway's catalog; judge stays on the startup model"
  classifier_model=
fi
selected_limits=$(printf '%s\n' "$selected" | jq -r '
  def integer_or_zero:
    if type == "number" and . > 0 and floor == . then . else 0 end;
  "\(.max_input_tokens | integer_or_zero) \(.max_tokens | integer_or_zero) \(.max_serving_input_tokens | integer_or_zero)"
')
context_tokens=${selected_limits%% *}
limits_rest=${selected_limits#* }
output_tokens=${limits_rest%% *}
serving_cap=${limits_rest#* }

summary=$(printf '%s\n' "$selected" | jq -er '
  def positive_integer:
    type == "number" and . > 0 and floor == .;
  def safe_scalar:
    (type == "string" or type == "number")
    and (tostring | explode | all(. >= 32 and . != 127));
  . as $row
  | (if ($row.pricing | type) == "object" then $row.pricing else {} end) as $pricing
  | (if ($row.capabilities | type) == "object" then $row.capabilities else {} end) as $caps
  | [
      "selected \($row.canonical_id)",
      "context \(if ($row.max_input_tokens | positive_integer) then $row.max_input_tokens else "unknown" end)",
      "output \(if ($row.max_tokens | positive_integer) then $row.max_tokens else "unknown" end)",
      "serving input \(if ($row.max_serving_input_tokens | positive_integer) then $row.max_serving_input_tokens else "unknown" end)"
    ]
    + ([
        {key: "prompt", label: "input"},
        {key: "completion", label: "output"},
        {key: "input_cache_read", label: "cache read"},
        {key: "input_cache_write", label: "cache write"},
        {key: "input_cache_write_5m", label: "cache write 5m"},
        {key: "input_cache_write_1h", label: "cache write 1h"}
      ]
      | map(. as $field | $pricing[$field.key] as $value
          | select($value | safe_scalar)
          | "\($field.label) $\($value)/token"))
    + ((if ($caps.effort | type) == "object" then $caps.effort else {} end)
      | [to_entries[]
          | select(.key != "supported" and .value.supported == true)
          | .key
          | select(explode | all(. >= 32 and . != 127))]
      | if length > 0 then ["reasoning \(join("/"))"] else [] end)
    + ($caps
      | [to_entries[]
          | select(.key != "effort" and .key != "thinking")
          | select(.value.supported == true)
          | .key
          | select(explode | all(. >= 32 and . != 127))]
      | if length > 0 then ["capabilities \(join(","))"] else [] end)
  | join(" · ")
') || die 65 "selected catalog row is malformed"
say "$summary"
if [ "$requested_from_state" = true ]; then
  say "model '$requested_model' restored from a prior /model pick ($launcher_settings); relaunch with --model, or delete its \"model\" key to reset to $default_model."
fi
say "/model switches freely among catalog models; a pick becomes the next launch's model, and numeric limits recompute only at launch."
say "Claude /usage is a client estimate; gateway actual is printed on exit."

# Inline CLI settings outrank user settings for a trustworthy published
# context. Missing or malformed context keeps Claude Code's conservative
# unknown-model enforcement and does not invent a window.
unset CLAUDE_CODE_MAX_CONTEXT_TOKENS CLAUDE_CODE_AUTO_COMPACT_WINDOW CLAUDE_CODE_MAX_OUTPUT_TOKENS \
  CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT
if [ "$context_tokens" -le 0 ] || [ "$output_tokens" -le 0 ] || [ "$serving_cap" -le 0 ]; then
  die 65 "model '$requested_model' has incomplete numeric limits; refusing an unsafe launch"
fi
output_reservation=$output_tokens
[ "$output_reservation" -le 20000 ] || output_reservation=20000
max_context_tokens=$((serving_cap + output_reservation + 3000))
auto_compact_tokens=$((serving_cap + output_reservation - 7000))
if [ "$auto_compact_tokens" -lt 100000 ]; then
  say "model '$requested_model' leaves only $auto_compact_tokens tokens for auto-compaction"
  die 65 "Claude Code ignores compact windows below 100000; refusing an unsafe launch"
fi
unset DISABLE_COMPACT DISABLE_AUTO_COMPACT CLAUDE_AUTOCOMPACT_PCT_OVERRIDE
settings=$(jq -cn \
  --argjson rows "$rows" \
  --arg classifier "$classifier_model" \
  --arg key_helper "$key_helper" \
  --arg max_context "$max_context_tokens" \
  --arg auto_compact "$auto_compact_tokens" \
  --arg max_output "$output_tokens" '{
    autoCompactEnabled: true,
    availableModels: ((($rows | map(.id)) + [$classifier]) | map(select(length > 0)) | unique),
    enforceAvailableModels: true,
    env: {
      CLAUDE_CODE_MAX_CONTEXT_TOKENS: $max_context,
      CLAUDE_CODE_AUTO_COMPACT_WINDOW: $auto_compact,
      CLAUDE_CODE_MAX_OUTPUT_TOKENS: $max_output,
      DISABLE_COMPACT: "",
      DISABLE_AUTO_COMPACT: "",
      CLAUDE_AUTOCOMPACT_PCT_OVERRIDE: ""
    }
  } + (if $key_helper == "" then {} else {apiKeyHelper: $key_helper} end)')

export ANTHROPIC_MODEL="$selected_id"
export ANTHROPIC_DEFAULT_MODEL="$selected_id"
export ANTHROPIC_DEFAULT_FABLE_MODEL="$selected_id"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$selected_id"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${classifier_model:-$selected_id}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$selected_id"
export ANTHROPIC_SMALL_FAST_MODEL="$selected_id"
export CLAUDE_CODE_SUBAGENT_MODEL="$selected_id"

# Keep the wrapper alive when the foreground Claude process receives terminal
# interruption, so the authoritative gateway session ledger is still printed.
trap ':' INT TERM
unset CODEX_LB_API_KEY
PATH="$HOME/.local/libexec/codex-lb:$PATH" \
  claude --settings "$settings" --model "$selected_id" "$@"
claude_status=$?
# Claude has returned, so keep impatient follow-up interrupts from killing the
# bounded authoritative-ledger read. Ignored dispositions also protect curl;
# reset them immediately before returning Claude's original status.
trap '' INT TERM

usage_json=$(
  {
    printf 'header = %s\n' "$auth_header"
    printf '%s\n' 'header = "accept: application/json"'
  } | curl --silent --show-error --fail --max-time 8 \
    --retry 2 --retry-max-time 20 --config - --get \
    --data-urlencode "cache_key=$usage_key" \
    "$ANTHROPIC_BASE_URL/api/usage/session"
) || usage_json=

usage_summary=
if [ -n "$usage_json" ]; then
  usage_summary=$(printf '%s\n' "$usage_json" | jq -er --arg key "$usage_key" '
    if .cache_key != $key or (.by_model | type) != "array" then
      error("invalid gateway usage ledger")
    else
      .by_model as $rows
      | ($rows | map(.total_cost // 0) | add // 0) as $cost
      | ($rows | map(.request_count // 0) | add // 0) as $requests
      | ($rows | map(.prompt_tokens // 0) | add // 0) as $prompt
      | ($rows | map(.cache_read_input_tokens // 0) | add // 0) as $cache_read
      | ($rows | map(.cache_creation_input_tokens // 0) | add // 0) as $cache_write
      | ($rows | map(.cache_accounted_input_tokens // 0) | add // 0) as $cache_accounted
      | ($rows | all(.cache_metrics_complete == true)) as $cache_complete
      | ($rows | map(.output_tokens // 0) | add // 0) as $output
      | ($prompt + $output) as $tokens
      | ([$cache_accounted - $cache_read - $cache_write, 0] | max) as $fresh
      | ([$prompt - $cache_accounted, 0] | max) as $unaccounted
      | (if $cache_complete and $cache_accounted > 0
          then (($cache_read * 1000 / $cache_accounted | round) / 10 | tostring) + "%"
          else "unavailable"
        end) as $cache_pct
      | "Gateway actual: $\($cost) · \($requests) requests · \($tokens) total tokens · \($prompt) prompt · \($cache_read)/\($cache_accounted) cache read (\($cache_pct)) · \($cache_write) cache write · \($fresh) fresh · \($unaccounted) unaccounted · \($output) output"
    end
  ' 2>/dev/null) || usage_summary=
fi
if [ -n "$usage_summary" ]; then
  printf '%s\n' "$usage_summary"
else
  say "gateway usage summary unavailable"
fi

trap - INT TERM
exit "$claude_status"
